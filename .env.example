# SkillPilot Environment Configuration

# Database Configuration (PostgreSQL / SQLite for local testing)
DATABASE_URL=sqlite:///./skillpilot.db
# For PostgreSQL: postgresql+psycopg2://postgres:password@localhost:5432/skillpilot

# Security & Authentication
JWT_SECRET_KEY=skillpilot_super_secure_jwt_secret_key_change_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration (Gemini API)
GEMINI_API_KEY=

# Storage Configuration (Supabase Storage / S3 / Local)
STORAGE_BACKEND=local
STORAGE_BUCKET_NAME=evidence-artifacts
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Application & CORS
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
